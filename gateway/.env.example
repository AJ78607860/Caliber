# Caliber gateway — local config
#
# Copy this file to .env and fill in real values. .env is gitignored.
# For production, use a real secrets manager (AWS Secrets Manager, Doppler,
# etc.) and don't ship .env files anywhere.

# --- Upstream LLM provider ---
# Leave blank to run the gateway in DEMO mode — Public/Private tiers will
# return canned responses so you can show the redaction + audit flow without
# burning real API tokens. Highly recommended for first-run demos.
ANTHROPIC_API_KEY=

# --- Sealed tier ---
# Week 1: a mock model returns deterministic responses.
# Week 2: point this at your Ollama or vLLM endpoint.
SEALED_BACKEND=mock                 # mock | ollama | vllm
SEALED_BACKEND_URL=http://localhost:11434
SEALED_MODEL=llama3.2:3b

# --- Service config ---
CALIBER_PORT=8800
CALIBER_LOG_LEVEL=INFO
CALIBER_AUDIT_DIR=../audit          # relative to gateway/ — keeps the runtime
                                    # log out of the gateway source tree

# --- Tenants ---
# Path to per-tenant YAML configs (the policy engine reads these on each
# request). Tenant ID is passed in the X-Caliber-Tenant header.
CALIBER_TENANTS_DIR=../config/tenants

# --- Default tenant policy ---
# Used when X-Caliber-Tenant is not provided (e.g. first-run demo).
# Production should reject calls without an explicit tenant.
CALIBER_DEFAULT_TENANT=demo
